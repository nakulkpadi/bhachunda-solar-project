# Browser-safe values only. Do not place service-role or Google Drive secrets here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only Google OAuth values. Configure these only in Supabase Edge
# Function secrets, not in this file and never in the frontend.
# GOOGLE_DRIVE_AUTH_MODE=oauth
# DRIVE_ROOT_FOLDER_ID=your-google-drive-root-folder-id
# GOOGLE_OAUTH_CLIENT_ID=your-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=replace-in-supabase-secret-store
# DRIVE_TOKEN_ENCRYPTION_KEY=replace-in-supabase-secret-store
